# Oshilife v2 本番設定テンプレート。秘密情報・実際の本番値は含まない。
# 本番配置先で .env として用意する。ローカルの .env を上書きしない。
# 空欄を確認済みの値で埋めるまで使用しない。APP_URLはHTTPSの公開URL。
APP_ENV=production
APP_URL=
# APP_URLから公開パスを算出するため、通常は空欄のまま。
APP_BASE_PATH=
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# APP_DEBUG / SESSION_SECURE_COOKIE は現行コードが参照しないので設定しない。
# productionでSecure Cookieが有効。HTTPSとHTTPからの転送はサーバー側で準備する。
# display_errorsとdisplay_startup_errorsは本番PHP設定でもOffにする。
# セッション保存先はプロジェクト配下のstorage/sessions（書込み権限が必要）。
